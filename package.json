{
  "name": "fahdar",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "test:db": "node --test tests/integration.test.mjs",
    "icons": "NODE_PATH=$(npm root -g) node scripts/make-icons.cjs",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview"
  },
  "private": true
}
